// Configuración de la base de datos para Prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


generator client {
  provider = "prisma-client-js"
}

// Modelo base para registrar módulos de la plataforma. A futuro se podrán
// añadir más tablas y relaciones dependiendo de las necesidades de cada
// mini‑proyecto.
model Module {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tabla para gestionar las solicitudes de reembolso del Front Office.  Cada
// registro representa una solicitud realizada por un huésped o generada
// internamente y almacena tanto los datos de la reserva como los detalles
// del reembolso.  Incluye relaciones con los adjuntos relacionados.
// Tabla para gestionar las solicitudes de reembolso del Front Office.
model RefundRequest {
  id              Int      @id @default(autoincrement())
  bookingNumber   String
  guestName       String
  email           String?
  phone           String?
  amountRequested Decimal?
  reason          String
  details         String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attachments RefundAttachment[]
}

// Tabla que almacena los documentos adjuntos de las solicitudes de
// reembolso.  Cada adjunto se clasifica por tipo y guarda la ruta
// relativa donde se almacenó el archivo en el servidor.
model RefundAttachment {
  id              Int           @id @default(autoincrement())
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  refundRequestId Int
  type            String
  fileName        String
  filePath        String
  uploadedAt      DateTime      @default(now())
}

model OesCategory {
  id          Int       @id @default(autoincrement())
  key         String    @unique       // ej. "design-objects", "linen"
  name        String                 // ej. "Design Objects"
  description String?                // texto descriptivo opcional
  order       Int       @default(0)  // para ordenar las tabs
  items       OesItem[]
}

model OesItem {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  category    OesCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  item        String
  who         String?
  notes       String?
  ideas       String?
  finalised   Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
model Employee {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  preferredName String?
  status        String   @default("ACTIVE") // ACTIVE, LEFT, ON_LEAVE, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slots         StructureSlot[]
}

model RoleType {
  id          Int      @id @default(autoincrement())
  key         String   @unique        // "SUPERVISOR", "ROOM_ATTENDANT", etc.
  label       String
  sortLevel   Int      @default(0)
  colorKey    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       StructureSlot[]
}

model OrgSnapshot {
  id          Int      @id @default(autoincrement())
  name        String

  // En vez de enum:
  // "CURRENT" | "FUTURE"
  type        String   @unique

  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       StructureSlot[]
}

model StructureSlot {
  id              Int         @id @default(autoincrement())
  snapshotId      Int
  snapshot        OrgSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  roleTypeId      Int
  roleType        RoleType    @relation(fields: [roleTypeId], references: [id], onDelete: Restrict)

  // En vez de enum:
  // "ROLE" | "VACANCY" | "NOTE"
  slotType        String      @default("ROLE")

  displayName     String?

  employeeId      Int?
  employee        Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  reportsToSlotId Int?
  reportsToSlot   StructureSlot? @relation("SlotReporting", fields: [reportsToSlotId], references: [id], onDelete: SetNull)
  directReports   StructureSlot[] @relation("SlotReporting")

  orderIndex      Int         @default(0)
  posX            Float?
  posY            Float?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([snapshotId])
  @@index([roleTypeId])
  @@index([employeeId])
  @@index([reportsToSlotId])
}
